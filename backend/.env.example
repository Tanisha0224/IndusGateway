APP_ENV=development

# PostgreSQL connection (SQLAlchemy 2 + psycopg driver)
DATABASE_URL=postgresql+psycopg://indusgate:password@localhost:5432/indusgate
TEST_DATABASE_URL=postgresql+psycopg://indusgate_test:password@localhost:5432/indusgate_test
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT_SECONDS=30
DB_POOL_RECYCLE_SECONDS=1800

# Auth
JWT_SECRET=replace-with-a-64-char-hex-secret
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=1440

# Symmetric key for encrypting provider credentials and redaction mappings at rest.
# Fernet-compatible (urlsafe base64, 32 raw bytes). Never commit the real value.
ENCRYPTION_KEY=replace-with-a-fernet-generated-key

# Upstream provider credentials used only for seeding demo provider_credentials rows.
SEED_OPENAI_API_KEY=
SEED_GEMINI_API_KEY=
SEED_GROQ_API_KEY=

# USD -> INR rate used to estimate cost in rupees from provider token pricing.
USD_TO_INR_RATE=83.0

# Unified OpenAI-compatible gateway
GATEWAY_CONNECT_TIMEOUT_SECONDS=10
GATEWAY_READ_TIMEOUT_SECONDS=120
GATEWAY_MAX_BODY_BYTES=1000000
PII_PROTECTION_ENABLED=true
PII_FAIL_MODE=closed
PII_ENGINE=deterministic
PII_MAX_TEXT_CHARACTERS=100000
PII_RESPONSE_SCAN_ENABLED=true
PII_ALLOW_RESTORATION=false
PII_STORE_SANITIZED_CONTENT=false
PII_LOG_CONTENT=false
STREAMING_PRIVACY_ENABLED=true
STREAMING_PRIVACY_MODE=buffered
STREAMING_FAIL_MODE=closed
STREAMING_MAX_BUFFER_CHARACTERS=200000
STREAMING_MAX_EVENT_BYTES=1048576
STREAMING_PROVIDER_TIMEOUT_SECONDS=120
STREAMING_OUTPUT_CHUNK_CHARACTERS=256

# OpenAI-compatible upstreams. Leave keys empty in local development unless you
# are intentionally calling a real provider. Tests use mocked providers.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=

# India-hosted or vLLM-compatible model server.
INDIA_HOSTED_LLM_BASE_URL=
INDIA_HOSTED_LLM_API_KEY=

# Gemini adapter placeholder; Gemini-specific translation remains isolated from
# the OpenAI-compatible adapter.
GEMINI_API_KEY=
